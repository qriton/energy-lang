# audit_model.hlm — Full energy landscape audit
#
# Usage: qriton-hlm --script audit_model.hlm

load model.pt
set inits 500

# Survey all layers
survey-all

# Deep dive on each layer
landscape 0
landscape 1
landscape 2
landscape 3
landscape 4
landscape 5

# Safety: every write is gated automatically (protected basins must survive and
# at most 2% of their decisions may change). Show the pre-execution guards:
guards

# Baseline benchmark
benchmark

info
history
